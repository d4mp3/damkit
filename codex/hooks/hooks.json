{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard_readonly.py\" || true",
            "timeout": 10,
            "statusMessage": "devkit read-only guard"
          }
        ]
      }
    ]
  }
}
