{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ]
  },
  "extraKnownMarketplaces": {
    "dampe": {
      "source": { "source": "github", "repo": "d4mp3/geostack" }
    }
  },
  "enabledPlugins": {
    "geostack@dampe": true
  }
}
