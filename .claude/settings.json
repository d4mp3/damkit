{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo edit *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { git diff --quiet HEAD -- hooks/ || python3 hooks/test_guard_readonly.py 1>&2 || exit 2; }"
          }
        ]
      }
    ]
  }
}
